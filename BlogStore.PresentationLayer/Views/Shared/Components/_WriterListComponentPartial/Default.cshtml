@model BlogStore.PresentationLayer.Models.WriterWithArticleViewModel

<style>
    /* Yazar resimleri yuvarlak */
    .writer-img {
        width: 120px;
        height: 120px;
        object-fit: cover;
        display: block;
        margin: 0 auto;
        border-radius: 50%; /* yuvarlak */
    }

    /* Makale resimleri kare */
    .article-img {
        width: 150px;
        height: 150px;
        object-fit: cover;
        border-radius: 0; /* kare */
    }
</style>

<div class="row mb-4">
    <div class="d-flex flex-wrap gap-3 justify-content-center">
        @foreach (var writer in Model.Writers)
        {
            <div class="text-center" style="width: 120px;">
                <a href="?id=@writer.Id" class="text-decoration-none">
                    <img src="@writer.ImageUrl" class="writer-img" alt="@writer.Name" />
                    <div>@writer.Name @writer.Surname</div>
                </a>
            </div>
        }
    </div>
</div>

@if (Model.Articles != null && Model.Articles.Any())
{
    <div class="section search-result-wrap">
        <div class="container">
            <div class="row posts-entry">
                <div class="col-lg-12">
                    @foreach (var item in Model.Articles)
                    {
                        <div class="blog-entry d-flex blog-entry-search-item mb-4">
                            <a href="/Article/ArticleDetail/@item.Slug" class="img-link me-4">
                                <img src="@item.ImageUrl" alt="Image" class="article-img" />
                            </a>
                            <div>
                                <span class="date">
                                    @item.CreatedDate.ToString("dd-MMM-yyyy")
                                    <a href="#">@item.Category.CategoryName</a>
                                </span>
                                <h2><a href="/Article/ArticleDetail/@item.Slug">@item.Title</a></h2>
                                <p>@(item.Description.Length > 100 ? item.Description.Substring(0, 100) + "..." : item.Description)</p>
                                <p>
                                    <a href="/Article/ArticleDetail/@item.Slug" class="btn btn-sm btn-outline-primary">Read More</a>
                                </p>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}
else if (!string.IsNullOrEmpty(Model.SelectedAuthorId))
{
    <p>Bu yazara ait makale bulunamadı.</p>
}
