@model List<(string CategoryName, int ArticleCount)>
@using System.Text.Json

<div class="container mt-5">
    <h2 class="mb-4 text-center fw-bold">📊 Genel İstatistikler</h2>

    <div class="row">
        <div class="col-md-6 mb-4">
            <div class="card shadow-lg border-0 rounded-4 p-3">
                <div id="barChart"></div>
            </div>
        </div>

        <div class="col-md-6 mb-4">
            <div class="card shadow-lg border-0 rounded-4 p-3">
                <div id="donutChart"></div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>

<script>
    var categoryNames = @Html.Raw(JsonSerializer.Serialize(Model.Select(x => x.CategoryName)));
    var articleCounts = @Html.Raw(JsonSerializer.Serialize(Model.Select(x => x.ArticleCount)));
    var totalCount = articleCounts.reduce((a, b) => a + b, 0);

    var colors = ['#1E90FF', '#00C9A7', '#FF6B6B', '#FFA41B', '#7D5FFF', '#FF8C00'];

    var barOptions = {
        chart: {
            type: 'bar',
            height: 350,
            toolbar: { show: false }
        },
        plotOptions: {
            bar: {
                borderRadius: 8,
                horizontal: true,
                distributed: true
            }
        },
        series: [{
            name: 'Makale Sayısı',
            data: articleCounts
        }],
        xaxis: {
            categories: categoryNames,
            labels: {
                style: { fontSize: '14px' }
            }
        },
        colors: colors,
        title: {
            text: 'Kategoriye Göre Makale Sayısı',
            align: 'center',
            style: { fontSize: '18px', fontWeight: 'bold' }
        },
        dataLabels: {
            enabled: true,
            style: { fontSize: '14px', colors: ['#fff'] }
        }
    };
    var barChart = new ApexCharts(document.querySelector("#barChart"), barOptions);
    barChart.render();

    var donutOptions = {
        chart: {
            type: 'donut',
            height: 350
        },
        series: articleCounts,
        labels: categoryNames,
        colors: colors,
        title: {
            text: 'Kategori Dağılımı',
            align: 'center',
            style: { fontSize: '18px', fontWeight: 'bold' }
        },
        legend: {
            position: 'bottom',
            fontSize: '14px'
        },
        plotOptions: {
            pie: {
                donut: {
                    size: '70%',
                    labels: {
                        show: true,
                        total: {
                            show: true,
                            label: 'Toplam',
                            fontSize: '16px',
                            fontWeight: 'bold',
                            formatter: function() { return totalCount }
                        }
                    }
                }
            }
        }
    };
    var donutChart = new ApexCharts(document.querySelector("#donutChart"), donutOptions);
    donutChart.render();
</script>
