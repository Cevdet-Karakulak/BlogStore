@model BlogStore.EntityLayer.Entities.AppUser
@{
    ViewData["Title"] = "Profilim";
    Layout = "~/Views/AuthorLayout/Index.cshtml";
}

<style>
    .profile-header {
        background: linear-gradient(135deg, #0d6efd, #0a58ca);
        color: #fff;
        padding: 1.5rem 1rem; 
        text-align: center;
        border-radius: 1rem;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        margin-bottom: 1.5rem;
    }

        .profile-header img {
            width: 110px; 
            height: 110px;
            object-fit: cover;
            border-radius: 50%;
            border: 3px solid #fff;
            margin-bottom: 0.5rem;
            transition: transform 0.3s ease;
        }

            .profile-header img:hover {
                transform: scale(1.05);
            }

        .profile-header h3 {
            font-size: 1.4rem;
        }

        .profile-header p {
            margin-bottom: 0.2rem;
            font-size: 0.95rem;
        }

    /* Kart ve form */
    .card-modern {
        border: none;
        border-radius: 1.2rem;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
    }

    .form-control {
        border-radius: 0.75rem !important;
        padding: 0.75rem 1rem;
        font-size: 1rem;
    }

    .btn-gradient {
        background: linear-gradient(135deg, #0d6efd, #0a58ca);
        color: #fff;
        border: none;
        transition: all 0.3s ease;
    }

        .btn-gradient:hover {
            background: linear-gradient(135deg, #0b5ed7, #084298);
            transform: translateY(-2px);
        }
</style>

<div class="container my-4">
    <div class="profile-header">
        <img src="@ViewBag.imageurl" alt="Profil Resmi">
        <h3 class="fw-bold mb-1">@ViewBag.name @ViewBag.surname</h3>
        <p class="mb-0">@ViewBag.username</p>
        <p class="mb-0 small">📧 @ViewBag.email</p>
    </div>

    <div class="card card-modern">
        <div class="card-body p-4">
            <h4 class="fw-bold text-primary mb-4">Profil Bilgilerini Güncelle</h4>
            <form method="post" action="/Author/EditProfile" novalidate>
                <div class="mb-4">
                    <label asp-for="ImageUrl" class="form-label fw-semibold">Profil Resmi URL</label>
                    <input type="text" asp-for="ImageUrl" class="form-control" placeholder="Profil Resmi URL" />
                    <span class="text-danger" asp-validation-for="ImageUrl"></span>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label asp-for="Name" class="form-label fw-semibold">Ad</label>
                        <input type="text" asp-for="Name" class="form-control" placeholder="Ad" />
                        <span class="text-danger" asp-validation-for="Name"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Surname" class="form-label fw-semibold">Soyad</label>
                        <input type="text" asp-for="Surname" class="form-control" placeholder="Soyad" />
                        <span class="text-danger" asp-validation-for="Surname"></span>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="UserName" class="form-label fw-semibold">Kullanıcı Adı</label>
                    <input type="text" asp-for="UserName" class="form-control" placeholder="Kullanıcı Adı" />
                    <span class="text-danger" asp-validation-for="UserName"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Email" class="form-label fw-semibold">E-posta</label>
                    <input type="email" asp-for="Email" class="form-control" placeholder="E-posta" />
                    <span class="text-danger" asp-validation-for="Email"></span>
                </div>

                <div class="mb-4">
                    <label for="newPassword" class="form-label fw-semibold">Yeni Şifre</label>
                    <input type="password" name="newPassword" class="form-control" placeholder="Yeni Şifre" />
                </div>

                <button type="submit" class="btn btn-gradient btn-lg w-100 rounded-3 fw-semibold">Kaydet</button>
            </form>
        </div>
    </div>
</div>
