<!doctype html>
<html lang="en">
@await Component.InvokeAsync("_HeadLayoutComponentPartial")
<body>


    @await Component.InvokeAsync("_NavbarLayoutComponentPartial")

        @await Component.InvokeAsync("_ArticleDetailMainCoverImageComponentPartial", new { id = ViewBag.ArticleId })

    <section class="section">
        <div class="container">

            <div class="row blog-entries element-animate">

                <div class="col-md-12 col-lg-8 main-content">

                        @await Component.InvokeAsync("_ArticleDetailContentComponentPartial", new { id = ViewBag.ArticleId })


                    <div class="pt-5">
                        <p>Kategori:  <a href="#">Spor</a>, <a href="#">Fenerbahce</a>  Tags: <a href="#">#Fenerbahce</a>, <a href="#">#Adidas</a></p>
                    </div>


                        @await Component.InvokeAsync("_ArticleDetailCommentListComponentPartial", new { id = ViewBag.ArticleId })

                </div>

                <!-- END main-content -->

                <div class="col-md-12 col-lg-4 sidebar">
                    <div class="sidebar-box search-form-wrap">
                        <form action="#" class="sidebar-search-form">
                            <span class="bi-search"></span>
                            <input type="text" class="form-control" id="s" placeholder="Aradığınız kelimeyi girin">
                        </form>
                    </div>
                    <!-- END sidebar-box -->
                        @await Component.InvokeAsync("_ArticleDetailAboutAuthorComponentPartial", new { id = ViewBag.ArticleId })
                        <!-- END sidebar-box -->
                    @await Component.InvokeAsync("_ArticleDetailPopularPostsComponentPartial")
                    <!-- END sidebar-box -->
                    @await Component.InvokeAsync("_ArticleDetailCategoryListComponentPartial")
                    <!-- END sidebar-box -->

                    <div class="sidebar-box">
                        <h3 class="heading">Tags</h3>
                        <ul class="tags">
                            <li><a href="#">Yazilim</a></li>
                            <li><a href="#">Teknoloji</a></li>
                            <li><a href="#">Tasarim</a></li>
                            <li><a href="#">Egitim</a></li>
                            <li><a href="#">Girisimcilik</a></li>
                            <li><a href="#">Spor</a></li>                            
                        </ul>
                    </div>
                </div>
                <!-- END sidebar -->

            </div>
        </div>
    </section>


    <!-- Start posts-entry -->
    <!-- End posts-entry -->
    <!-- Preloader -->
    @await Component.InvokeAsync("_ScriptsLayoutComponentPartial")


</body>
</html>